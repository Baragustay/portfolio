# Hostinger (Apache/LiteSpeed) config: SPA fallback, security headers and
# caching. Vite copies this file into dist/ as-is.

Options -Indexes
# public/about, public/code, public/game and public/work are real folders
# that share a name with SPA routes. Without this, Apache answers /about by
# redirecting to /about/ and then 403s (no index.html in that folder).
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SPA fallback: anything that isn't a real file goes to index.html so
  # React Router can handle it. Real directories (other apps deployed in
  # subfolders) are left alone, except the asset folders above that
  # double as routes.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d [OR]
  RewriteCond %{REQUEST_URI} ^/(about|code|game|work)/?$
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Google Analytics (gtag.js) is the only external script/beacon. Google
  # Fonts is only used by game/catch-a-fact.html. 'unsafe-inline' on
  # style-src is needed because framer-motion animates via inline `style`
  # attributes. `data:` on font-src is for @fontsource/press-start-2p,
  # which embeds a base64 .woff fallback in its CSS.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://www.google-analytics.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; media-src 'self'; frame-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # The standalone game runs its logic in inline <script> tags, so it needs
  # 'unsafe-inline' — loosened for this one file only.
  <Files "catch-a-fact.html">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; font-src 'self' https://fonts.gstatic.com; media-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
  </Files>

  # Vite's hashed build assets never change, so cache them for a year;
  # index.html must always be revalidated so new deploys show up.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
